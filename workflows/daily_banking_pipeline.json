{
  "name": "daily_banking_pipeline",
  "description": "Daily banking and insurance analytics pipeline — replaces the SAS Control-M scheduled jobs (run_daily_banking.sas, claims_processing.sas, policy_valuation.sas, monthly_regulatory_reporting.sas, customer_profitability.sas). Executes dbt models in dependency order: staging → intermediate → marts → test. See docs/CICD_NARRATIVE.md for the full migration mapping from Control-M to Databricks Workflows.",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "dbt_staging",
      "description": "Load and validate raw data into staging layer. Replaces SAS Step 1 (%run_step(1, Load Customer Accounts, load_customer_accounts.sas)), daily_transaction_processing.sas validation, and claims_processing.sas (Step 1: hash object policy lookup).",
      "dbt_task": {
        "project_directory": "/Workspace/Repos/production/uc-data-migration-sas-to-databricks/dbt_project",
        "commands": [
          "dbt deps",
          "dbt run --select tag:staging --target {{job.parameters.dbt_target}}"
        ],
        "warehouse_id": "${var.databricks_warehouse_id}",
        "catalog": "banking_analytics",
        "schema": "prod"
      },
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true
    },
    {
      "task_key": "dbt_intermediate",
      "description": "Compute derived metrics and business logic. Replaces SAS Step 2 (DATA step computing ACCT_AGE_MONTHS, UTILIZATION_PCT, DORMANCY_FLAG), claims_processing.sas (Steps 2-4: fraud screening and adjudication), and policy_valuation.sas (Steps 1-4: premium, claims experience, reserves).",
      "depends_on": [
        {
          "task_key": "dbt_staging"
        }
      ],
      "dbt_task": {
        "project_directory": "/Workspace/Repos/production/uc-data-migration-sas-to-databricks/dbt_project",
        "commands": [
          "dbt run --select tag:intermediate --target {{job.parameters.dbt_target}}"
        ],
        "warehouse_id": "${var.databricks_warehouse_id}",
        "catalog": "banking_analytics",
        "schema": "prod"
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true
    },
    {
      "task_key": "dbt_marts",
      "description": "Build final analytical outputs. Replaces SAS Step 3 (credit_risk_scoring.sas), monthly_regulatory_reporting.sas (RWA and delinquency aging), policy_valuation.sas (Step 5: loss ratios), and customer_profitability.sas (Steps 1-4: P&L). Includes incremental transaction loading, risk scoring, anomaly detection, regulatory reporting, and insurance analytics.",
      "depends_on": [
        {
          "task_key": "dbt_intermediate"
        }
      ],
      "dbt_task": {
        "project_directory": "/Workspace/Repos/production/uc-data-migration-sas-to-databricks/dbt_project",
        "commands": [
          "dbt run --select tag:marts --target {{job.parameters.dbt_target}}"
        ],
        "warehouse_id": "${var.databricks_warehouse_id}",
        "catalog": "banking_analytics",
        "schema": "prod"
      },
      "timeout_seconds": 7200,
      "max_retries": 1,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true
    },
    {
      "task_key": "dbt_test",
      "description": "Run all schema and data tests. SAS had no equivalent — QA was manual PROC PRINT/PROC SQL spot checks. dbt tests enforce data contracts declaratively after every run.",
      "depends_on": [
        {
          "task_key": "dbt_marts"
        }
      ],
      "dbt_task": {
        "project_directory": "/Workspace/Repos/production/uc-data-migration-sas-to-databricks/dbt_project",
        "commands": [
          "dbt test --target {{job.parameters.dbt_target}}"
        ],
        "warehouse_id": "${var.databricks_warehouse_id}",
        "catalog": "banking_analytics",
        "schema": "prod"
      },
      "timeout_seconds": 1800,
      "max_retries": 0
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {
    "on_failure": [
      "data-engineering-alerts@example.com"
    ],
    "on_success": [],
    "on_duration_warning_threshold_exceeded": [
      "data-engineering-alerts@example.com"
    ],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {
    "on_failure": [
      {
        "id": "${var.pagerduty_webhook_id}"
      },
      {
        "id": "${var.slack_webhook_id}"
      }
    ],
    "on_duration_warning_threshold_exceeded": [
      {
        "id": "${var.slack_webhook_id}"
      }
    ]
  },
  "notification_settings": {
    "no_alert_for_canceled_runs": true,
    "alert_on_last_attempt": true
  },
  "health": {
    "rules": [
      {
        "metric": "RUN_DURATION_SECONDS",
        "op": "GREATER_THAN",
        "value": 10800
      }
    ]
  },
  "tags": {
    "team": "data-engineering",
    "domain": "banking-analytics",
    "migration_source": "sas-control-m",
    "environment": "production"
  },
  "parameters": [
    {
      "name": "dbt_target",
      "default": "prod"
    }
  ]
}
