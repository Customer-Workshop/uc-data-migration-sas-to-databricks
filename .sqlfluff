[sqlfluff]
dialect = databricks
templater = jinja
max_line_length = 120
large_file_skip_byte_limit = 25000
# Exclude layout/spacing and structure rules that conflict with the existing
# code style (migrated from SAS). These can be tightened incrementally as the
# team adopts stricter formatting standards.
exclude_rules = LT01, LT02, LT05, ST01, ST06, RF02

# Use the jinja templater for CI-friendly linting (no live Databricks
# connection required). dbt-specific functions (ref, source, config,
# is_incremental) are stubbed via apply_dbt_builtins.
[sqlfluff:templater:jinja]
apply_dbt_builtins = true
load_macros_from_path = dbt_project/macros

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = false
indented_ctes = false
indented_using_on = true

[sqlfluff:layout:type:comma]
line_position = trailing

# ── Rule Configuration ──────────────────────────────────────────────────
# These rules enforce consistent SQL style across the migrated dbt models.
# In SAS, there was no SQL style enforcement — PROC SQL accepted any
# formatting. These rules ensure the dbt codebase stays readable and
# consistent as the team grows.

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = implicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.length]
min_alias_length = 1

[sqlfluff:rules:convention.terminator]
multiline_newline = true
require_final_semicolon = false
