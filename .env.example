# Copy to .env and fill in. The Makefile includes .env, and those values win
# over anything already exported in the shell.
#
# HTTP path is the SQL warehouse the run uses. List the warehouses a token can
# see with:
#   curl -s -H "Authorization: Bearer $DATABRICKS_TOKEN" \
#     "$DATABRICKS_HOST/api/2.0/sql/warehouses" | jq '.warehouses[] | {id, name}'

DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>
DATABRICKS_TOKEN=dapi...

# Source schema the models read: `raw` (synthetic seed) or `raw_sas` (extract
# of the legacy estate's own input CSVs, used for SAS golden comparisons).
RAW_SCHEMA=raw

# Business date the models run as. Empty means current_date(); set it to the
# SAS batch date when comparing against SAS golden outputs.
RUN_DATE=
